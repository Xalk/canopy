{
  "name": "canopy-cli",
  "version": "0.1.0",
  "description": "One command to bring up a ready-to-work Claude Code environment on any server.",
  "private": true,
  "type": "module",
  "bin": {
    "canopy": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "Dockerfile",
    "entrypoint.sh",
    "config",
    "scripts",
    ".dockerignore",
    "examples",
    ".railwayignore"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "format": "biome check --write",
    "check": "biome check && tsc && node --test \"dist/test/*.test.js\"",
    "test": "tsc && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.1",
    "commander": "^15.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2"
  }
}
