# canopy environment. Copy to .env and fill in. Never commit .env.
# Any variable can also be read from a file: set FOO_FILE=/run/secrets/foo instead of FOO
# (Docker secrets on a VPS). Plain variables work everywhere (Railway, local).

# --- Required -------------------------------------------------------------

# Public SSH key(s) allowed to log in as root. Several keys: separate with ';'.
# Where: contents of ~/.ssh/id_ed25519.pub on your machine.
AUTHORIZED_KEYS=

# GitHub token used by gh and git (clone, pull, push, PRs).
# Where: GitHub -> Settings -> Developer settings -> Fine-grained tokens.
# Minimal scopes: only the repos below + vault; Contents: read/write, Pull requests: read/write, Metadata: read.
GH_TOKEN=

# Author for commits made in the container.
GIT_NAME=
GIT_EMAIL=

# --- Workspace ------------------------------------------------------------

# personal | project. Describes intent only; V1 behaves the same for both (see README).
PROFILE=personal

# Repos to clone into ~/projects/<name>, comma-separated: owner/name or full URL.
REPOS=

# Branch to check out right after the first clone. Empty = repo default branch.
DEFAULT_BRANCH=

# Knowledge vault repo cloned into ~/vault and synced every 5 min. Empty = no vault.
VAULT_REPO=

# Agent working directory (absolute path). Empty = first repo from REPOS, else ~.
WORKDIR=

# --- Integrations (optional) ----------------------------------------------

# Linear API key; adds the linear-server MCP. Where: Linear -> Settings -> Security & access -> API keys.
LINEAR_API_KEY=

# Telegram bot token for the channel plugin. Where: @BotFather -> /newbot.
TELEGRAM_BOT_TOKEN=

# --- System ---------------------------------------------------------------

# Container timezone, e.g. Europe/Berlin. Affects vault-sync commit times.
TZ=UTC
