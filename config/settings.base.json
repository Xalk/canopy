{
  "enabledPlugins": {
    "telegram@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": { "source": "github", "repo": "anthropics/claude-plugins-official" }
    }
  },
  "statusLine": { "type": "command", "command": "limits.sh status" },
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "typing.sh start" }] }],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "typing.sh start" }] }
    ],
    "Stop": [{ "hooks": [{ "type": "command", "command": "typing.sh stop" }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "typing.sh stop" }] }],
    "StopFailure": [
      { "matcher": "rate_limit", "hooks": [{ "type": "command", "command": "limits.sh reached" }] },
      { "hooks": [{ "type": "command", "command": "typing.sh stop" }] }
    ]
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "mcp__plugin_telegram_telegram",
      "Read(~/.claude/channels/telegram/inbox/**)",
      "Read(~/.canopy/handoff.md)",
      "Edit(~/.canopy/handoff.md)",
      "mcp__linear-server__list_issues",
      "mcp__linear-server__get_issue",
      "mcp__linear-server__list_comments",
      "mcp__linear-server__save_issue",
      "mcp__linear-server__save_comment",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git rebase *)",
      "Bash(gh pr view)",
      "Bash(gh pr view *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh repo view *)",
      "Bash(git -C ~/vault pull)",
      "Bash(git -C ~/vault pull *)",
      "Bash(git -C ~/vault status)",
      "Bash(git -C ~/vault status *)",
      "Bash(git -C ~/vault log)",
      "Bash(git -C ~/vault log *)",
      "Bash(git -C ~/vault diff)",
      "Bash(git -C ~/vault diff *)",
      "Bash(git -C /root/vault pull)",
      "Bash(git -C /root/vault pull *)",
      "Bash(git -C /root/vault status)",
      "Bash(git -C /root/vault status *)",
      "Bash(git -C /root/vault log)",
      "Bash(git -C /root/vault log *)",
      "Bash(git -C /root/vault diff)",
      "Bash(git -C /root/vault diff *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(pwd *)",
      "Bash(date)",
      "Bash(date *)",
      "Bash(true)",
      "Bash(true *)",
      "Bash(test *)",
      "Bash(which *)",
      "Bash(fresh.sh)",
      "Bash(/usr/local/bin/fresh.sh)"
    ],
    "ask": [
      "Bash(git push --force-with-lease *)",
      "Bash(git -C * push --force-with-lease *)",
      "Bash(git push --force-with-lease=*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.staging)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.test)",
      "Read(**/.env.backup)",
      "Read(**/.env.bak)",
      "Read(~/.claude/.credentials.json)",
      "Read(/proc/*/environ)",
      "Bash(git push --force origin *)",
      "Bash(git -C * push --force origin *)"
    ],
    "additionalDirectories": []
  }
}
