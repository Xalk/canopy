# syntax=docker/dockerfile:1
# Tools live in the image; all state lives in the /root volume.
FROM ubuntu:24.04

ARG CLAUDE_CODE_VERSION=2.1.326
ARG NODE_MAJOR=24
ARG DEBIAN_FRONTEND=noninteractive

ENV LANG=C.UTF-8 \
    DISABLE_AUTOUPDATER=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git gh tmux openssh-server jq ripgrep build-essential \
      unzip tzdata less \
 && curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://bun.sh/install | BUN_INSTALL=/usr/local bash

# Native installer writes into $HOME; install into a throwaway HOME and keep only the binary,
# so nothing lands in /root (the volume) and image upgrades actually upgrade claude.
RUN curl -fsSL https://claude.ai/install.sh | HOME=/opt/claude-install bash -s ${CLAUDE_CODE_VERSION} \
 && cp -L /opt/claude-install/.local/bin/claude /usr/local/bin/claude \
 && rm -rf /opt/claude-install \
 && claude --version

# SSH: key-only. Host keys are generated by entrypoint into the volume so they survive rebuilds.
RUN mkdir -p /run/sshd && cat > /etc/ssh/sshd_config.d/canopy.conf <<'EOF'
PermitRootLogin prohibit-password
PasswordAuthentication no
KbdInteractiveAuthentication no
HostKey /root/.canopy/ssh/ssh_host_ed25519_key
EOF

# SSH sessions don't inherit the container env; import it from PID 1 (only vars not already set).
RUN cat > /etc/profile.d/canopy-env.sh <<'EOF'
while IFS= read -r -d '' kv; do
  k=${kv%%=*}
  [ -z "${!k+x}" ] && export "$kv" 2>/dev/null
done < /proc/1/environ
EOF

COPY . /opt/canopy
RUN chmod +x /opt/canopy/entrypoint.sh /opt/canopy/scripts/*.sh \
 && ln -s /opt/canopy/scripts/*.sh /usr/local/bin/

WORKDIR /root
EXPOSE 22
ENTRYPOINT ["/opt/canopy/entrypoint.sh"]
